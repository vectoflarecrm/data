# --- Database ---
DATABASE_URL=postgresql+asyncpg://watersports:watersports@localhost:5432/watersports
# Optional test database (created automatically by the test harness)
TEST_DATABASE_URL=postgresql+asyncpg://watersports:watersports@localhost:5432/watersports_test

# --- App ---
APP_NAME=Global Watersports B2B Intelligence Database
APP_ENV=development
LOG_LEVEL=INFO

# --- Gemini CLI provider ---
GEMINI_CLI_COMMAND=gemini
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=120
GEMINI_CLI_ENABLED=true

# --- Crawlers ---
CRAWL4AI_ENABLED=true
CRAWL4AI_STRATEGY=css
PLAYWRIGHT_ENABLED=false
HTTPX_TIMEOUT_SECONDS=30

# --- Crawling policy (conservative) ---
MAX_PAGES_PER_COMPANY=15
MAX_DEPTH=2
REQUEST_DELAY_SECONDS=2
DOMAIN_CONCURRENCY=2
AI_MAX_CONCURRENCY=1
MAX_REQUESTS_PER_MINUTE=30

# --- Research workers ---
RESEARCH_WORKERS=3
TASK_MAX_ATTEMPTS=5
TASK_STALENESS_SECONDS=1800

# --- Scoring (weights, must sum to 100) ---
SCORE_PRODUCT_FIT=20
SCORE_COMPANY_FIT=15
SCORE_MARKET_FIT=15
SCORE_PURCHASING_POTENTIAL=20
SCORE_CONTACT_QUALITY=10
SCORE_GROWTH_SIGNALS=10
SCORE_DATA_COMPLETENESS=5
SCORE_RECENT_ACTIVITY=5

# --- Security ---
MAX_CSV_UPLOAD_MB=20